# ============================================================
# Interactive Question
# ============================================================

def interactive_question():

    print()
    print("=" * 70)
    print(
        f"RAG {RAG_VERSION} Interactive Question"
    )
    print("=" * 70)

    print()
    print(
        "请输入法律问题："
    )

    try:

        question = input(
            "> "
        ).strip()

    except EOFError:

        question = ""

    if not question:

        print()
        print(
            "⚠️ 未输入问题。"
        )

        return ""

    return answer_question(
        question=question,
        top_k=5,
        score_threshold=0.55,
        model=OLLAMA_MODEL,
    )


